{
  "version": 1,
  "purpose": "Deterministic quality checks for ios-architect reference playbooks.",
  "defaults": {
    "testing_section_heading_regex": "^##\\s+Testing strategy\\s*$",
    "required_any_groups": [
      {
        "label": "observable behavior under test",
        "patterns": [
          "\\bstate\\b",
          "\\bsuccess\\b",
          "\\bloading\\b",
          "\\bloaded\\b",
          "\\broute\\b",
          "\\bpresenter\\b",
          "\\binteractor\\b",
          "\\breducer\\b",
          "\\bstore\\b"
        ]
      },
      {
        "label": "failure or error path",
        "patterns": [
          "\\bfailure\\b",
          "\\berror\\b",
          "\\bretry\\b",
          "\\brejected\\b",
          "\\bfailed\\b"
        ]
      },
      {
        "label": "test double or dependency boundary",
        "patterns": [
          "\\bfake\\b",
          "\\bmock\\b",
          "\\bspy\\b",
          "\\bspies\\b",
          "\\brepository\\b",
          "\\bdependency\\b",
          "\\bTestStore\\b"
        ]
      },
      {
        "label": "deterministic execution guidance",
        "patterns": [
          "\\bdeterministic\\b",
          "\\bcontrolled\\b",
          "\\bscheduler\\b",
          "\\bclock\\b",
          "\\bwithout UIKit\\b",
          "\\bpure\\b",
          "\\binput\\b",
          "\\boutput\\b"
        ]
      }
    ],
    "required_patterns": [
      {
        "label": "testing bullets",
        "regex": "(?m)^- ",
        "min_count": 2
      },
      {
        "label": "cancellation guidance",
        "regex": "\\b(cancel|cancellation|stale)\\b",
        "scope": "file"
      },
      {
        "label": "review checklist",
        "regex": "(?m)^##\\s+Review checklist\\b",
        "scope": "file"
      },
      {
        "label": "anti-pattern coverage",
        "regex": "(?m)^##\\s+Anti-patterns\\b",
        "scope": "file"
      }
    ]
  },
  "playbooks": [
    {
      "architecture": "mvc",
      "name": "MVC",
      "path": "plugin/skills/ios-architect/references/mvc.md"
    },
