{
  "version": 1,
  "description": "Deterministic architecture assertions for ios-architect reference playbooks.",
  "cases": [
    {
      "id": "mvc-reference-positive",
      "architecture": "mvc",
      "file": "plugin/skills/ios-architect/references/mvc.md",
      "architecture_assertions": [
        {
          "label": "has architecture title",
          "regex": "^#\\s+.+",
          "expect_match": true
        },
        {
          "label": "has testing strategy",
          "regex": "^##\\s+Testing strategy\\s*$",
          "expect_match": true
        },
        {
          "label": "has review checklist",
          "regex": "^##\\s+Review checklist\\s*$",
          "expect_match": true
        }
      ]
